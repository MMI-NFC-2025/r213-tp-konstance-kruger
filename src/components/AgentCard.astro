---
const { agent } = Astro.props;

if (!agent) {
    return Astro.redirect("/agent");
}
---

<div class="card">
    <h2>{agent.nom}</h2>
    <p>{agent.prenom}</p>
    {agent.email && <p> {agent.email}</p>}
    <a href={`/agent/${agent.id}`}>Voir plus</a>
</div>

<style>
    .card {
        border: 1px solid #ddd;
        padding: 1rem;
        border-radius: 8px;
        max-width: 260px;
    }
</style>