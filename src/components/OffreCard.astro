---
const offre  = Astro.props.offre;
console.log(offre);
import PbImage from "./PbImage.astro";
import { setFavori } from "../js/backend.mjs";

---

<div 
  class={[
    "relative bg-white rounded-lg shadow-md p-6",
    offre.favori ? "border-l-4 border-white-400" : "border-l-4 border-gray-200"
  ].join(" ")}
  data-id={offre.id}
  data-favori={offre.toString()}
>
<PbImage record={offre} recordImage={offre.images[0]} />
  <h3 class="text-lg font-semibold text-gray-900 mb-3">{offre.nom_maison}</h3>
  <button 
    class="btn-favori bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md font-medium text-sm" 
    data-id={offre.id}
  >
    {offre.favori ? 'Favori' : 'Ajouter'}
  </button>
  <button 
    class="favoriteButton absolute bottom-0 left-0 p-2 text-white rounded-br-lg" 
    data-offre={JSON.stringify(offre)}
  >
    <img 
      id="favorite-icon" 
      src={offre.favori ? "favorite_filled.png" : "favorite.png"} 
      alt="Favorite Icon" 
      class="w-6 h-6" 
    />
  </button>
</div>

<script>
  //@ts-nocheck
  import { setFavori } from "../js/backend.mjs";
  const favoriteButtons = document.querySelectorAll(".favoriteButton");

  favoriteButtons.forEach(button => {
    button.addEventListener('click', () => {
      const offreData = JSON.parse(button.dataset.offre || '{}');
      const newFavori = !offreData.favori;

      setFavori(offreData);

      const favIcon = button.querySelector('#favorite-icon');
      if (favIcon) {
        favIcon.src = newFavori ? "/favorite_filled.png" : "/favorite.png";
      }
      offreData.favori = newFavori;
      button.dataset.offre = JSON.stringify(offreData);
    });
  });
</script>

