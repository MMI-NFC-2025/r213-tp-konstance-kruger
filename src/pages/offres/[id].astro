---
import { getOffres } from "../../js/backend.mjs";
import Layout from "../../layouts/Layout.astro";

import PbImage from "../../components/PbImage.astro";

const { id } = Astro.params;
const offre = await getOffres(id);
console.log(offre);
---

<Layout titre={offre.nom_maison}>
    <h2>{offre.nom_maison}</h2>
    <PbImage record={offre} recordImage={offre.images[0]} />
    <ul>
        <li>{offre.adresse}</li>
    </ul>
</Layout>